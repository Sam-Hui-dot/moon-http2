name = "Sam-Hui-dot/moon-http2"

version = "0.1.0"

license = "Apache-2.0"

readme = "README.md"

repository = "https://github.com/Sam-Hui-dot/moon-http2"

keywords = [
  "http2",
  "hpack",
  "rfc9113",
  "rfc7541",
  "sans-io",
  "protocol",
  "server",
]

description = "Pure-MoonBit RFC 9113 HTTP/2 and RFC 7541 HPACK Sans-I/O protocol engine, native async h2c server, SVG wire timeline visualizer, and browser frame studio"

preferred_target = "wasm"

import {
  "moonbitlang/async@0.22.4",
}
